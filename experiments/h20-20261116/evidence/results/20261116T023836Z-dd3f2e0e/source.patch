+bool available() { return true; }
+char const *name() { return "bare-sm90a-bf16-64x128x64-vector-or-tma-ring"; }
+void *prepare(Problem p, Buffers b, cudaStream_t) {
+  if (p.m <= 0 || p.n <= 0 || p.k <= 0 || p.k % 8 || p.n % 8 ||
+      !b.a || !b.b || !b.d)
+    throw std::runtime_error("candidate: invalid dimensions or buffers");
+  auto c = std::make_unique<Context>();
+  c->problem = p;
+  c->buffers = b;
+  char const *mode = std::getenv("BARE_GEMM_STAGES");
+  c->stages = mode ? std::stoi(mode) : 2;
+  if (c->stages < 0 || c->stages > 4)
+    throw std::runtime_error("BARE_GEMM_STAGES must be 0 (vector), or 1..4 (TMA)");
+  if (c->stages) {
+    make_map(c->map_a, b.a, p.m, p.k, BM);
+    make_map(c->map_b, b.b, p.n, p.k, BN);
+    check(cudaFuncSetAttribute(tma_gemm<1>, cudaFuncAttributeMaxDynamicSharedMemorySize, 24576));
+    check(cudaFuncSetAttribute(tma_gemm<2>, cudaFuncAttributeMaxDynamicSharedMemorySize, 49152));
+    check(cudaFuncSetAttribute(tma_gemm<3>, cudaFuncAttributeMaxDynamicSharedMemorySize, 73728));
+    check(cudaFuncSetAttribute(tma_gemm<4>, cudaFuncAttributeMaxDynamicSharedMemorySize, 98304));
+  }
+  return c.release();
 }
